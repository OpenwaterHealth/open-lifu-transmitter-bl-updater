/*
 * Generated by CMake from src/bl_blob.s.in: embeds the bootloader binary that this
 * updater programs at 0x08000000. It lives in .rodata, so it is inside the signed image
 * and the running bootloader authenticates it (FwTag) before the updater starts.
 *
 *   BL_IMAGE : @BL_IMAGE_ABS@
 *   BL_TAG   : @BL_TAG@
 *   size     : @BL_IMAGE_SIZE@ bytes
 *   sha256   : @BL_IMAGE_SHA256@
 */
    .syntax unified
    .section .rodata.updater_bl_image,"a",%progbits
    .global updater_bl_image_start
    .global updater_bl_image_end
    .balign 4
updater_bl_image_start:
    .incbin "@BL_IMAGE_ABS@"
updater_bl_image_end:
    .balign 4
